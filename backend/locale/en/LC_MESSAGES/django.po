msgstr "Monday"

msgid "سه‌شنبه"
msgstr "Tuesday"

msgid "چهارشنبه"
msgstr "Wednesday"

msgid "پنج‌شنبه"
msgstr "Thursday"

msgid "جمعه"
msgstr "Friday"

msgid "شنبه"
msgstr "Saturday"

